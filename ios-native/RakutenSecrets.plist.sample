<?xml version="1.0" encoding="UTF-8"?>
<!--
  これは楽天ブックスAPIの認証情報 (Secrets.plist) の「テンプレート」です。
  楽天ウェブサービス (https://webservice.rakuten.co.jp/) でアプリID/アフィリエイトIDを取得したら、
  以下の場所に本物の値を入れたファイルを配置してください:

    ios-native/MangaShelf/Resources/Secrets.plist

  このファイル (RakutenSecrets.plist.sample) はあくまで参考用のテンプレートで、
  .gitignore により実ファイル (Resources/Secrets.plist) はコミット対象外になっています。

  値が空文字のままでも動作します(その場合は楽天APIへのリクエストを行わず、
  最新刊確認はAniListへのフォールバックのみで行われます)。
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>RakutenApplicationID</key>
	<string></string>
	<key>RakutenAccessKey</key>
	<string></string>
</dict>
</plist>
